{
  "expo": {
    "name": "rent-control",
    "slug": "rent-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rent-control-icon-no-text.png",
    "scheme": "rentcontrol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyalk123.rentcontrol"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "launchMode": "singleTask",
      "package": "com.eyalk123.rentcontrol",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/rent-control-icon-no-text.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rent-control-icon-no-text.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-localization",
      ["expo-build-properties",{"android":{"usesCleartextTraffic":true}}],
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access contacts to quickly add renters."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "organization": "eyal-kook",
          "project": "rent-control"
        }
      ]
    ],
    "extra": {},
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
