# Backend API base URL
# - iOS simulator / web: http://localhost:8000
# - Android emulator: http://10.0.2.2:8000
# - Physical device: http://YOUR_COMPUTER_IP:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase web client ID
# Find it in: Firebase Console → Project Settings → Your apps → Web app → Client ID
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=your_firebase_web_client_id_here

# Sentry DSN for crash reporting. Only needed for a local run; EAS builds take it from
# the matching profile in eas.json, because this file is gitignored and never reaches a
# build. Find it in: Sentry → Your Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry crash reports are only readable if the build uploaded its source maps and native
# symbols, which needs an auth token. It is a secret, so it does NOT belong here or in
# eas.json — set it once with:
#     eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value <token>
# Create the token at Sentry → Settings → Auth Tokens. Without it a build still succeeds
# and still reports, but every stack trace arrives minified.

# Dev web preview: `npx expo start --web` only, for looking at UI in a browser.
# Firebase auth is a native module and throws in a browser, so 1 skips sign-in with a fake
# user and forces the mock API on. Ignored on iOS/Android and in any non-dev build.
EXPO_PUBLIC_DEV_WEB_PREVIEW=0
